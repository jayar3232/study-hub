{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://study-hub-app.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://study-hub-app.onrender.com/socket.io/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://study-hub-app.onrender.com/uploads/:path*"
    },
    {
      "source": "/releases/:path*",
      "destination": "https://study-hub-app.onrender.com/releases/:path*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
